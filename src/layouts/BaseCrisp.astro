---
/**
 * BaseCrisp — light "crisp" layout for the re-skinned marketing surface
 * (design system: docs/design/tracelane-homepage-crisp.html). White canvas,
 * lava accent, Plus Jakarta Sans + JetBrains Mono. Carries the SEO/OG/JSON-LD
 * from Base.astro. Nav + footer live here (light); the shared dark Header/Footer
 * stay on the not-yet-re-skinned pages.
 */
import "../styles/crisp.css";

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
}

const {
  title = "tracelane — the flight recorder for AI agents",
  description = "Open-source gateway for AI agents. Trace every run, replay the exact failure, and prove what happened with a tamper-evident ledger. Self-host or start free. V1 coming soon.",
  canonical = Astro.url.pathname,
  ogImage = "/og-default.png",
} = Astro.props;

const siteUrl = "https://tracelane.dev";
const fullCanonical = new URL(canonical, siteUrl).toString();
const fullOgImage = new URL(ogImage, siteUrl).toString();

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://tracelane.dev/#org",
      name: "Tracelane",
      url: "https://tracelane.dev",
      logo: "https://tracelane.dev/og-default.png",
      sameAs: ["https://github.com/tracelane", "https://newsletter.aitechhive.com"],
    },
    {
      "@type": "SoftwareApplication",
      name: "Tracelane",
      applicationCategory: "DeveloperApplication",
      operatingSystem: "Linux, macOS, Windows",
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      softwareVersion: "1.0.0",
      license: "https://www.apache.org/licenses/LICENSE-2.0",
      url: "https://tracelane.dev",
    },
  ],
};

// The official "Chisel" brand mark (same as the app + favicon + Header): two
// brackets, a bar, and a target. Ink via currentColor; the target centre uses
// the page bg. NEVER a generic placeholder.
const mark = `<svg viewBox="0 0 76 76" aria-hidden="true"><path d="M30 14 L14 14 L14 62 L30 62 L30 56 L20 56 L20 20 L30 20 Z" fill="currentColor"/><path d="M46 14 L62 14 L62 62 L46 62 L46 56 L56 56 L56 20 L46 20 Z" fill="currentColor"/><rect x="20" y="36.4" width="36" height="3.2" fill="currentColor"/><circle cx="38" cy="38" r="9" fill="var(--bg)" stroke="currentColor" stroke-width="3"/><circle cx="38" cy="38" r="3.6" fill="none" stroke="currentColor" stroke-width="2.6"/></svg>`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={fullCanonical} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Tracelane" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={fullCanonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <div class="scroll-progress" id="scroll-progress"></div>
    <a href="#main" class="skip-link">skip to content</a>

    <header>
      <div class="wrap nav">
        <a href="/" class="brand"><span class="mk" set:html={mark} />tracelane</a>
        <nav class="nlinks">
          <a href="#pillars">Gateway</a>
          <a href="#pillars">Observability</a>
          <a href="#audit">Audit</a>
          <a href="#pricing">Pricing</a>
          <a href="/docs">Docs</a>
        </nav>
        <div class="ncta">
          <a href="https://github.com/tracelane" rel="me noopener" class="btn btn-ghost">GitHub</a>
          <a href="#notify" class="btn btn-lava">Be first to know</a>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer>
      <div class="wrap">
        <div class="fg">
          <div class="fbrand">
            <a href="/" class="brand"><span class="mk" set:html={mark} />tracelane</a>
            <p>The flight recorder for AI agents. Open source, Apache 2.0.</p>
          </div>
          <div class="fcol">
            <h5>Product</h5>
            <a href="#pillars">Gateway</a><a href="#pillars">Observability</a><a href="#audit">Audit</a><a href="#pricing">Pricing</a>
          </div>
          <div class="fcol">
            <h5>Developers</h5>
            <a href="/docs">Docs</a><a href="https://github.com/tracelane" rel="me noopener">GitHub</a><a href="/security">Security</a><a href="/changelog">Changelog</a>
          </div>
          <div class="fcol">
            <h5>Legal</h5>
            <a href="/privacy">Privacy</a><a href="/terms">Terms</a><a href="/security">Security</a>
          </div>
        </div>
        <div class="fbot">
          <span>© 2026 Tracelane · Apache-2.0 core</span>
          <span>Your keys · 0% markup · Self-host anywhere</span>
        </div>
      </div>
    </footer>

    <script is:inline>
      // top scroll-progress bar
      (function () {
        var bar = document.getElementById("scroll-progress");
        if (!bar) return;
        var ticking = false;
        function update() {
          var h = document.documentElement;
          var max = h.scrollHeight - h.clientHeight;
          bar.style.transform = "scaleX(" + (max > 0 ? h.scrollTop / max : 0) + ")";
          ticking = false;
        }
        update();
        window.addEventListener("scroll", function () {
          if (!ticking) { ticking = true; requestAnimationFrame(update); }
        }, { passive: true });
        window.addEventListener("resize", update, { passive: true });
      })();

      // scroll reveal (respects prefers-reduced-motion via CSS)
      (function () {
        var els = document.querySelectorAll(".reveal");
        if (!("IntersectionObserver" in window) || !els.length) return;
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); }
          });
        }, { threshold: 0.12, rootMargin: "0px 0px -40px 0px" });
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
