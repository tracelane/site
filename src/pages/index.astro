    <div class="hcta"><a href="#notify" class="btn btn-lava">Be first to know →</a><a href="/docs" class="btn btn-ghost">Read the docs</a></div>
  </div></div>
</BaseCrisp>

<script is:inline>
  // hero video stage — reveal native player on click
  (function () {
    var btn = document.getElementById("hero-play");
    var vid = document.getElementById("hero-video");
    if (!btn || !vid) return;
    btn.addEventListener("click", function () {
      btn.style.display = "none";
      vid.style.display = "block";
      var p = vid.play();
      if (p && p.catch) p.catch(function () {});
    });
  })();
</script>
