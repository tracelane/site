---
import Base from "../layouts/Base.astro";
---

<Base>
  {/* ===== Hero ===== */}
  <header class="hero wrap">
    <div class="hero-mesh" aria-hidden="true">
      <div class="mesh a"></div>
      <div class="mesh b"></div>
    </div>

    <div class="eyebrow"><b>●</b> record · replay · prove — open source, apache-2.0</div>
    <h1>The <span class="grad">flight recorder</span> for AI&nbsp;agents.</h1>
    <p class="sub">
      Agents fail without crashing — every call returns a clean 200 while the run drifts off course.
      Tracelane records the entire execution path to a tamper-evident, cryptographically signed
      ledger.
    </p>
    <div class="cta-row">
      <a class="btn" href="#notify">Get the launch email</a>
      <a class="btn ghost" href="https://github.com/tracelane" rel="me noopener">Watch on GitHub</a>
    </div>
    <div class="cta-note">self-host anywhere · your keys, 0% markup · repo opens at v1</div>

    {/* product frame — recorded trace (demo) */}
    <div class="frame">
      <div class="fbar">
        <i></i><i></i><i></i><span class="fbar-addr">app.tracelane.dev — trace a3f8-2e1b-9c04</span>
      </div>
      <div class="fhead">
        <span class="ft">checkout.process_refund</span>
        <span class="ferr">error inside</span>
        <span class="fled">recorded · ledger #8408–8414</span>
      </div>
      <div class="fs">
        <div class="frail"></div>
        <div class="frow">
          <div class="fdot"></div><div class="fc">
            <span class="fk">agent</span><span class="fn">plan_refund_flow</span><span class="fms"
              >18&nbsp;ms</span
            ><span class="fhash">#8408 ✓</span>
          </div>
        </div>
        <div class="frow">
          <div class="fdot"></div><div class="fc">
            <span class="fk">llm</span><span class="fn">gen_ai.chat · claude-opus-4</span><span
              class="fms">612&nbsp;ms · 1,204&nbsp;tok</span
            ><span class="fhash">#8409 ✓</span>
          </div>
        </div>
        <div class="frow">
          <div class="fdot"></div><div class="fc">
            <span class="fk">tool</span><span class="fn">get_order(id=48213)</span><span class="fms"
              >84&nbsp;ms</span
            ><span class="fhash">#8410 ✓</span>
          </div>
        </div>
        <div class="frow">
          <div class="fdot err"></div><div class="fc">
            <span class="fk">tool</span><span class="fn">refund_payment(…)</span><span
              class="fms fms-err">6&nbsp;ms</span
            ><span class="fhash bad">#8413 ✗</span>
          </div>
          <div class="fseen">
            <b>tool-schema-violation</b> — matched a known failure signature · seen 34× before · rejected
            pre-dispatch
          </div>
        </div>
        <div class="frow">
          <div class="fdot"></div><div class="fc">
            <span class="fk">agent</span><span class="fn">await_human_approval</span><span
              class="fms">—</span
            ><span class="fhash">#8414 ✓</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  {/* ===== Success codes lie ===== */}
  <section id="what">
    <div class="wrap">
      <div class="cap">Why agent failures stay invisible</div>
      <h2>Success codes lie.</h2>
      <p class="lede">
        A 200 and clean tokens say nothing about whether the state is still valid three steps later.
        Tracelane reconstructs the causal path, not just the request log.
      </p>
      <div class="tri">
        <div class="card-i">
          <svg class="ic" viewBox="0 0 40 40" fill="none" aria-hidden="true"
            ><circle cx="20" cy="20" r="15" stroke="currentColor" stroke-width="2"></circle><circle
              cx="20"
              cy="20"
              r="5"
              fill="var(--lava)"></circle></svg
          >
          <h3>Record</h3>
          <p>
            One gateway endpoint in front of every model. Bring your own keys, 0% markup, bounded
            overhead — every call captured in full fidelity.
          </p>
          <a href="#arch" class="ul">How the gateway works →</a>
        </div>
        <div class="card-i g2">
          <svg class="ic" viewBox="0 0 40 40" fill="none" aria-hidden="true"
            ><path
              d="M8 20a12 12 0 1 1 3.5 8.5"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"></path><path
              d="M8 28v-8h8"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path><path
              d="M20 14v7l5 3"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path></svg
          >
          <h3>Replay</h3>
          <p>
            Step-level trace of prompts, tool calls, latency, and cost — down to the exact call that
            broke, and whether you've seen it before.
          </p>
          <a href="#arch" class="ul">See how replay works →</a>
        </div>
        <div class="card-i g3">
          <svg class="ic" viewBox="0 0 40 40" fill="none" aria-hidden="true"
            ><path
              d="M20 5l12 6v9c0 7.5-5 12.5-12 15-7-2.5-12-7.5-12-15v-9z"
              stroke="currentColor"
              stroke-width="2"
              stroke-linejoin="round"></path><path
              d="M14 20l4 4 8-8"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path></svg
          >
          <h3>Prove</h3>
          <p>
            A tamper-evident ledger — SHA-256 hash chain, Ed25519-signed Merkle root — anyone can
            verify offline. Logs you can't argue with.
          </p>
          <a href="#audit" class="ul">The audit ledger →</a>
        </div>
      </div>
    </div>
  </section>

  {/* ===== Architecture ===== */}
  <section id="arch">
    <div class="wrap">
      <div class="cap">Architecture</div>
      <h2>One recorder between your agents and every model.</h2>
      <p class="lede">
        Point your agent at the Tracelane gateway. Calls route to any of 30+ providers with your own
        keys; every event lands in the trace store and is hash-chained into the tenant ledger.
      </p>
      <div class="diagram">
        <svg
          viewBox="0 0 880 300"
          fill="none"
          role="img"
          aria-label="Your agent connects to the Tracelane gateway, which routes to 30+ providers with your keys and records every event to a tamper-evident per-tenant ledger that anyone can verify offline with tlane verify."
        >
          <rect
            x="20"
            y="110"
            width="150"
            height="80"
            rx="12"
            fill="var(--bg)"
            stroke="var(--line-2)"></rect>
          <text
            x="95"
            y="143"
            text-anchor="middle"
            fill="var(--ink)"
            font-size="12"
            font-weight="600">your agent</text
          >
          <text x="95" y="162" text-anchor="middle" fill="var(--ink-3)" font-size="9.5"
            >any framework · SDK or proxy</text
          >

          <path d="M170 150 H 250" stroke="var(--ink-3)" stroke-width="1.5" marker-end="url(#arr)"
          ></path>

          <rect
            x="252"
            y="92"
            width="190"
            height="116"
            rx="12"
            fill="var(--card)"
            stroke="url(#gline)"
            stroke-width="2"></rect>
          <text
            x="347"
            y="122"
            text-anchor="middle"
            fill="var(--ink)"
            font-size="12"
            font-weight="600">tracelane gateway</text
          >
          <text x="347" y="141" text-anchor="middle" fill="var(--ink-3)" font-size="9.5"
            >rust · BYOK · 0% markup</text
          >
          <text x="347" y="158" text-anchor="middle" fill="var(--ink-3)" font-size="9.5"
            >pre-flight policy checks</text
          >
          <rect
            x="277"
            y="170"
            width="140"
            height="20"
            rx="10"
            fill="var(--verify-soft)"
            stroke="var(--verify-line)"></rect>
          <text x="347" y="184" text-anchor="middle" fill="var(--verify-deep)" font-size="9.5"
            >records every event</text
          >

          <path d="M442 128 H 520" stroke="var(--ink-3)" stroke-width="1.5" marker-end="url(#arr)"
          ></path>

          <rect
            x="522"
            y="40"
            width="150"
            height="176"
            rx="12"
            fill="var(--bg)"
            stroke="var(--line-2)"></rect>
          <text
            x="597"
            y="66"
            text-anchor="middle"
            fill="var(--ink)"
            font-size="12"
            font-weight="600">30+ providers</text
          >
          <text x="597" y="88" text-anchor="middle" fill="var(--ink-3)" font-size="9.5"
            >anthropic · openai</text
          >
          <text x="597" y="104" text-anchor="middle" fill="var(--ink-3)" font-size="9.5"
            >gemini · bedrock</text
          >
          <text x="597" y="120" text-anchor="middle" fill="var(--ink-3)" font-size="9.5"
            >azure · cohere</text
          >
          <text x="597" y="142" text-anchor="middle" fill="var(--ink-3)" font-size="9.5"
            >+ any openai-compatible</text
          >
          <text x="597" y="158" text-anchor="middle" fill="var(--ink-3)" font-size="9.5"
            >endpoint</text
          >
          <text
            x="597"
            y="196"
            text-anchor="middle"
            fill="var(--ink-3)"
            font-size="10"
            letter-spacing="0.6">YOUR KEYS</text
          >

          <path d="M347 208 V 244" stroke="var(--verify)" stroke-width="1.5" marker-end="url(#arrg)"
          ></path>

          <rect
            x="192"
            y="246"
            width="310"
            height="42"
            rx="12"
            fill="var(--verify-soft)"
            stroke="var(--verify-line)"></rect>
          <text
            x="347"
            y="264"
            text-anchor="middle"
            fill="var(--verify-deep)"
            font-size="12"
            font-weight="600">tamper-evident ledger</text
          >
          <text x="347" y="279" text-anchor="middle" fill="var(--ink-3)" font-size="9.5"
            >sha-256 chain · ed25519-signed merkle roots · per tenant</text
          >

          <path
            d="M502 267 H 585"
            stroke="var(--ink-3)"
            stroke-width="1.5"
            stroke-dasharray="4 4"
            marker-end="url(#arr)"></path>

          <rect
            x="588"
            y="246"
            width="200"
            height="42"
            rx="12"
            fill="var(--card)"
            stroke="var(--line-2)"></rect>
          <text
            x="688"
            y="264"
            text-anchor="middle"
            fill="var(--ink)"
            font-size="12"
            font-weight="600">tlane verify</text
          >
          <text x="688" y="279" text-anchor="middle" fill="var(--ink-3)" font-size="9.5"
            >offline · no trust in us required</text
          >

          <defs>
            <linearGradient id="gline" x1="0" y1="0" x2="1" y2="1"
              ><stop offset="0%" stop-color="var(--lava)"></stop><stop
                offset="100%"
                stop-color="var(--lava-2)"></stop></linearGradient
            >
            <marker id="arr" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"
              ><path d="M0,0 L8,4 L0,8" fill="none" stroke="var(--ink-3)" stroke-width="1.5"
              ></path></marker
            >
            <marker id="arrg" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"
              ><path d="M0,0 L8,4 L0,8" fill="none" stroke="var(--verify)" stroke-width="1.5"
              ></path></marker
            >
          </defs>
        </svg>
        <div class="dg-note">
          trace store: clickhouse hot · r2 cold (eu) · metered in traces, not spans
        </div>
      </div>
    </div>
  </section>

  {/* ===== Audit ledger ===== */}
  <section id="audit">
    <div class="wrap">
      <div class="cap">The audit ledger</div>
      <h2>Every run. On the record. Provably.</h2>
      <div class="lgrid">
        <div>
          <p class="lede">
            Each event is hash-chained with SHA-256. Every 100 events, the Merkle root is signed
            with Ed25519. Verify the whole chain offline — tampering means breaking SHA-256 or
            forging a signature, not editing a row.
          </p>
          <div class="crows">
            <div class="crow">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"
                ><path
                  d="M12 3l7 4v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V7z"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linejoin="round"></path></svg
              >
              <span
                ><b>EU AI Act</b> — Article 12 export pack for high-risk systems. Annex III enforcement
                provisionally deferred to Dec 2, 2027 (Digital Omnibus, pending formal adoption). Build
                audit history before enforcement binds.</span
              >
            </div>
            <div class="crow">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"
                ><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"></circle><path
                  d="M12 7v5l3.5 2"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"></path></svg
              >
              <span
                ><b>India DPDP</b> — Phase II enforcement Nov 13, 2026. EU data residency at V1; India
                residency on the roadmap.</span
              >
            </div>
            <div class="crow">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"
                ><rect
                  x="4"
                  y="10"
                  width="16"
                  height="10"
                  rx="2"
                  stroke="currentColor"
                  stroke-width="2"></rect><path
                  d="M8 10V7a4 4 0 018 0v3"
                  stroke="currentColor"
                  stroke-width="2"></path></svg
              >
              <span
                ><b>HIPAA</b> — BAA on Business tier roadmap. PII redaction inline. Provider keys envelope-encrypted.</span
              >
            </div>
          </div>
        </div>
        <div class="term" aria-label="tlane verify terminal session">
          <span class="c"># verify any trace offline — no trust in us required</span><br />
          <span class="w">$ tlane verify a3f8-2e1b-9c04</span><br />
          <span class="g">✓ signature valid (Ed25519, Merkle root)</span><br />
          <span class="g">✓ hash chain unbroken (SHA-256)</span><br />
          <span class="g">✓ tamper-evident: yes</span>
          <span class="cursor" aria-hidden="true">▋</span>
        </div>
      </div>
    </div>
  </section>

  {/* ===== Mid-page capture ===== */}
  <section id="notify-mid">
    <div class="wrap">
      <div class="midcap">
        <div class="midcap-copy">
          <div class="cap">Launching soon</div>
          <h2 class="midcap-h">Get the launch email.</h2>
          <p class="lede">
            One email the day V1 is live — the repo, the reliability benchmark, the launch links.
            Nothing else unless you opt in.
          </p>
        </div>
        <form class="capform js-notify" method="POST" action="/api/notify" novalidate>
          <label class="sr-only" for="email-mid">email address</label>
          <input
            id="email-mid"
            class="capinput"
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder="you@company.com"
          />
          <button class="btn" type="submit">Get the launch email</button>
          <p class="capstatus" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>

  {/* ===== Pricing ===== */}
  <section id="pricing">
    <div class="wrap">
      <div class="cap">Pricing</div>
      <h2>Self-host free forever. Hosted from $0.</h2>
      <div class="pgrid">
        <div class="tier">
          <h3>OSS self-host</h3><div class="pr m">$0</div>
          <div class="qty">full apache 2.0 stack · forever</div>
          <ul>
            <li>
              Rust gateway · 30+ providers — 6 native adapters plus any OpenAI-compatible endpoint
            </li>
            <li>ClickHouse + R2 storage</li>
            <li>Audit ledger included</li>
          </ul>
        </div>
        <div class="tier rec">
          <span class="rt">recommended</span>
          <h3>Team</h3><div class="pr m">$249<small>/mo</small></div>
          <div class="qty">1M traces + 1M gateway / mo · 10 seats</div>
          <ul>
            <li>90-day retention · +$19/seat to 25</li>
            <li>WorkOS SSO · 99% SLA · Slack support</li>
            <li>Predictive pre-flight + tamper-evident promotion record</li>
          </ul>
        </div>
        <div class="tier">
          <h3>Business</h3><div class="pr m">$899<small>/mo</small></div>
          <div class="qty">5M traces + 5M gateway / mo · 25 seats</div>
          <ul>
            <li>180-day retention · +$19/seat to 50</li>
            <li>99.9% SLA · dedicated Slack</li>
          </ul>
        </div>
      </div>

      <div class="addon">
        <div class="t">
          <h3>Tamper-evident agent ledger <span class="ships">ships at v1</span></h3>
          <p>
            SHA-256 hash chain + Ed25519-signed Merkle roots · EU AI Act Article 12 export pack · EU
            data residency · configurable audit retention.
          </p>
        </div>
        <div class="pr m">+$999<small>/mo</small></div>
      </div>

      <div class="meter m">
        also: free hosted $0 (10K+10K) · builder $59 (150K+150K) · enterprise $2,999+ (25M+, 365d,
        region pinning EU at v1) · metered in traces, not spans · failed requests aren't billed
      </div>
    </div>
  </section>

  {/* ===== FAQ ===== */}
  <section id="faq">
    <div class="wrap">
      <div class="cap">Frequently asked</div>
      <h2>Straight answers.</h2>
      <div class="faqcard">
        <details>
          <summary>What is Tracelane?</summary>
          <p>
            An open-source (Apache 2.0) flight recorder for AI agents: a universal Rust LLM gateway,
            full-fidelity OpenTelemetry observability, and a tamper-evident audit ledger. Each event
            is SHA-256 hash-chained and the Merkle root is Ed25519-signed every 100 events, so any
            trace can be verified offline.
          </p>
        </details>
        <details>
          <summary>How is it different from Helicone, LangSmith, or Langfuse?</summary>
          <p>
            Tracelane unifies the gateway, observability, pre-flight policy, and a tamper-evident
            audit ledger in one Rust binary. The others are observability-first — you bring your own
            gateway and guardrails. No competitor in this category offers cryptographic audit-log
            integrity at the trace level. <a href="/vs/langsmith-engine" class="ul"
              >vs LangSmith Engine →</a
            >
          </p>
        </details>
        <details>
          <summary>What's the latency overhead?</summary>
          <p>
            Gateway overhead targets p50 &lt;5ms, p95 &lt;15ms, p99 &lt;25ms (excluding provider
            time). Pre-flight policy targets p99 &lt;50ms on commodity CPU. These are engineering
            targets — measured numbers publish as the Tracelane Reliability Benchmark v1.0 at
            launch.
          </p>
        </details>
        <details>
          <summary>When does V1 launch?</summary>
          <p>
            Soon — we're finishing the V1 quality gate. Drop your email and you'll get a single
            message the day it's live, with the Show HN, X, LinkedIn, and Bluesky links.
          </p>
        </details>
      </div>
    </div>
  </section>

  {/* ===== Final band capture ===== */}
  <section id="notify" class="final">
    <div class="wrap">
      <div class="band">
        <h2>Get the V1 launch email.</h2>
        <p class="lede">
          One email the day we launch. Then nothing unless you opt into product updates.
        </p>
        <form class="capf js-notify" method="POST" action="/api/notify" novalidate>
          <label class="sr-only" for="email-final">email address</label>
          <input
            id="email-final"
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder="you@company.com"
          />
          <button class="btn" type="submit">Get the launch email</button>
          <p class="capstatus" aria-live="polite"></p>
        </form>
        <div class="small">no newsletter · no marketing automation</div>
      </div>
    </div>
  </section>
</Base>

<script is:inline>
  // Email capture — both the mid-page and final-band forms POST /api/notify.
  (function () {
    var forms = document.querySelectorAll("form.js-notify");
    if (!forms.length) return;
    forms.forEach(function (form) {
      var status = form.querySelector(".capstatus");
      form.addEventListener("submit", async function (e) {
        e.preventDefault();
        var input = form.querySelector("input[type='email']");
        var btn = form.querySelector("button[type='submit']");
        if (!input) return;
        var email = input.value.trim();
        if (status) status.textContent = "Sending…";
        if (btn) btn.disabled = true;
        try {
          var res = await fetch("/api/notify", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email: email }),
          });
          if (res.ok) {
            if (status)
              status.textContent = "You're on the list. We'll email you the day we launch.";
            form.reset();
          } else {
            var data = await res.json().catch(function () {
              return {};
            });
            if (status) status.textContent = data.error || "Something went wrong. Try again.";
          }
        } catch (err) {
          if (status) status.textContent = "Network error. Try again.";
        } finally {
          if (btn) btn.disabled = false;
        }
      });
    });
  })();
</script>

<style>
  /* ---------- hero ---------- */
  .hero {
    padding: var(--s16) 0 var(--s12);
    text-align: center;
    position: relative;
    z-index: 1;
  }
  .hero > *:not(.hero-mesh) {
    position: relative;
    z-index: 1;
  }
  .hero-mesh {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
    contain: paint;
  }
  .mesh {
    position: absolute;
    border-radius: 50%;
  }
  .mesh.a {
    width: 560px;
    height: 560px;
    top: -200px;
    right: -140px;
    opacity: 0.5;
    background: radial-gradient(
      circle at 35% 35%,
      color-mix(in srgb, var(--lava-2) 42%, transparent) 0%,
      color-mix(in srgb, var(--lava) 26%, transparent) 38%,
      transparent 70%
    );
  }
  .mesh.b {
    width: 520px;
    height: 520px;
    top: 60px;
    left: -220px;
    opacity: 0.4;
    background: radial-gradient(
      circle at 60% 40%,
      color-mix(in srgb, var(--mesh-blue) 32%, transparent) 0%,
      color-mix(in srgb, var(--verify) 22%, transparent) 55%,
      transparent 75%
    );
  }
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .mesh {
      will-change: transform;
    }
    .mesh.a {
      animation: drift 26s ease-in-out infinite alternate;
    }
    .mesh.b {
      animation: drift 32s ease-in-out infinite alternate-reverse;
    }
  }
  @keyframes drift {
    from {
      transform: translate(0, 0) scale(1);
    }
    to {
      transform: translate(-40px, 32px) scale(1.1);
    }
  }

  .eyebrow {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    font-family: var(--mono);
    font-size: 11px;
