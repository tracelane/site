<script is:inline>
  // hero video stage — reveal native player on click
  (function () {
    var play = document.getElementById("hero-play");
    var vid = document.getElementById("hero-video");
    if (!play || !vid) return;
    play.addEventListener("click", function () {
      play.style.display = "none";
      vid.currentTime = 0;
      vid.muted = false;
      vid.controls = true;
      var p = vid.play(); if (p && p.catch) p.catch(function () {});
    });
    vid.addEventListener("ended", function () {
      vid.controls = false;
      play.style.display = "";
    });
  })();

  // scroll reveal — single elements (.reveal) and staggered grids (.reveal-group)
  (function () {
    var els = document.querySelectorAll(".reveal, .reveal-group");
    if (!("IntersectionObserver" in window) || !els.length) return;
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); }
      });
    }, { threshold: 0.14, rootMargin: "0px 0px -40px 0px" });
    els.forEach(function (el) { io.observe(el); });
  })();

  // cursor-tracked spotlight on cards
  (function () {
    if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    var cards = document.querySelectorAll(".cards-hover > article, .cards-hover > div");
    cards.forEach(function (card) {
      card.addEventListener("pointermove", function (e) {
        var r = card.getBoundingClientRect();
        card.style.setProperty("--mx", ((e.clientX - r.left) / r.width) * 100 + "%");
        card.style.setProperty("--my", ((e.clientY - r.top) / r.height) * 100 + "%");
      });
    });
  })();

  // notify form
  (function () {
    var form = document.getElementById("notify-form");
    var status = document.getElementById("notify-status");
    if (!form || !status) return;
    form.addEventListener("submit", async function (e) {
      e.preventDefault();
      var emailInput = document.getElementById("email");
      var submitBtn = form.querySelector("button[type='submit']");
      if (!emailInput || !submitBtn) return;
      var email = emailInput.value.trim();
      status.textContent = "Sending...";
      submitBtn.disabled = true;
      try {
        var res = await fetch("/api/notify", {
          method: "POST",
          body: JSON.stringify({ email: email }),
          headers: { "Content-Type": "application/json" },
        });
        if (res.ok) { status.textContent = "You're on the list. We'll email you when something ships."; form.reset(); }
        else { var data = await res.json().catch(function () { return {}; }); status.textContent = data.error || "Something went wrong. Try again."; }
      } catch (err) { status.textContent = "Network error. Try again."; }
      finally { submitBtn.disabled = false; }
    });
  })();
</script>
