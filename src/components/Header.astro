---
// Sticky v2 nav — shared across all pages. Nav chrome may use backdrop-blur (§2).
---

<nav aria-label="Primary" class="site-nav">
  <div class="wrap navi">
    <a class="brand" href="/" aria-label="tracelane home">
      <svg viewBox="0 0 76 76" width="24" height="24" fill="none" aria-hidden="true">
        <path d="M30 14 L14 14 L14 62 L30 62 L30 56 L20 56 L20 20 L30 20 Z" fill="var(--ink)"
        ></path>
        <path d="M46 14 L62 14 L62 62 L46 62 L46 56 L56 56 L56 20 L46 20 Z" fill="var(--ink)"
        ></path>
        <rect x="20" y="36.4" width="36" height="3.2" fill="var(--lava)"></rect>
        <circle cx="38" cy="38" r="9" stroke="var(--ink)" stroke-width="3.5" fill="var(--card)"
        ></circle>
        <circle cx="38" cy="38" r="3.2" fill="var(--lava)"></circle>
      </svg>
      tracelane
    </a>
    <div class="nlinks">
      <a href="/#what">Product</a>
      <a href="/#audit">Ledger</a>
      <a href="/#pricing">Pricing</a>
      <a href="/docs">Docs</a>
      <a href="https://github.com/tracelane" rel="me noopener">GitHub</a>
      <a class="btn nav-cta" href="/#notify">Get the launch email</a>
    </div>
  </div>
</nav>

<style>
  .site-nav {
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }
  .navi {
    display: flex;
    align-items: center;
    gap: var(--s4);
    height: 62px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    font-family: var(--mono);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .brand svg {
    flex-shrink: 0;
  }
  .nlinks {
    display: flex;
    gap: var(--s3);
    font-size: 13.5px;
    margin-left: auto;
    align-items: center;
  }
  .nlinks a {
    color: var(--ink-2);
    transition: color var(--tr);
  }
  .nlinks a:hover {
    color: var(--ink);
  }
  .nav-cta {
    color: #fff;
    padding: 9px 16px;
    font-size: 13px;
    min-height: 40px;
  }
  @media (max-width: 860px) {
    .nlinks a:not(.nav-cta) {
      display: none;
    }
    .nav-cta {
      padding: 11px 18px;
    }
  }
</style>
