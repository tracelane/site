---
const chisel = `<svg viewBox="0 0 128 128" width="28" height="28" aria-hidden="true" class="logo-mark"><path fill="currentColor" d="M16 18h84L82 36H34v18h48L64 72H34v38L16 92V18Zm72 24h24L94 60H78v34L58 112V60h30V42Z"/></svg>`;
---

<footer class="border-border mt-24 border-t">
  <div class="w-full px-5 py-14 sm:px-8">
    <div class="grid gap-10 text-sm sm:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1fr_1fr]">
      <div class="max-w-xs">
        <p
          class="text-fg flex items-center gap-2.5 text-xl font-semibold lowercase"
          style="font-family:var(--font-display)"
        >
          <span set:html={chisel} />tracelane
        </p>
        <p class="text-fg-subtle mt-4 leading-relaxed">
          The flight recorder for AI agents. Open source, Apache 2.0.
        </p>
      </div>
      <nav aria-label="Product">
        <p class="text-fg-dim mb-4 font-mono text-xs tracking-wider uppercase">Product</p>
        <ul class="text-fg-muted space-y-2.5">
          <li><a href="/#what" class="hover:text-fg transition-colors">What</a></li>
          <li><a href="/#audit" class="hover:text-fg transition-colors">Audit Ledger</a></li>
          <li><a href="/#pricing" class="hover:text-fg transition-colors">Pricing</a></li>
          <li><a href="/docs" class="hover:text-fg transition-colors">Docs</a></li>
        </ul>
      </nav>
      <nav aria-label="Resources">
        <p class="text-fg-dim mb-4 font-mono text-xs tracking-wider uppercase">Resources</p>
        <ul class="text-fg-muted space-y-2.5">
          <li>
            <a
              href="https://github.com/tracelane"
              class="hover:text-fg transition-colors"
              rel="me noopener">GitHub</a
            >
          </li>
          <li><a href="/security" class="hover:text-fg transition-colors">Security</a></li>
          <li>
            <a
              href="https://newsletter.aitechhive.com"
              class="hover:text-fg transition-colors"
              rel="noopener">Working Notes</a
            >
          </li>
          <li><a href="/changelog" class="hover:text-fg transition-colors">Changelog</a></li>
        </ul>
      </nav>
      <nav aria-label="Legal">
        <p class="text-fg-dim mb-4 font-mono text-xs tracking-wider uppercase">Legal</p>
        <ul class="text-fg-muted space-y-2.5">
          <li><a href="/privacy" class="hover:text-fg transition-colors">Privacy</a></li>
          <li><a href="/terms" class="hover:text-fg transition-colors">Terms</a></li>
          <li class="text-fg-subtle pt-2">
            <a href="mailto:support@tracelane.dev" class="hover:text-fg transition-colors"
              >support@tracelane.dev</a
            >
          </li>
        </ul>
      </nav>
    </div>
    <div
      class="border-border text-fg-subtle mt-12 flex flex-col justify-between gap-2 border-t pt-6 font-mono text-xs sm:flex-row"
    >
      <p>© 2026 Tracelane. Apache 2.0 core.</p>
      <p>Open source · Self-host anywhere · Your keys, 0% markup</p>
    </div>
  </div>
</footer>
