---
const chisel = `<svg viewBox="0 0 76 76" width="20" height="20" aria-hidden="true" class="logo-mark">
  <path d="M30 14 L14 14 L14 62 L30 62 L30 56 L20 56 L20 20 L30 20 Z" fill="currentColor"/>
  <path d="M46 14 L62 14 L62 62 L46 62 L46 56 L56 56 L56 20 L46 20 Z" fill="currentColor"/>
  <rect x="20" y="36.4" width="36" height="3.2" fill="currentColor"/>
  <circle cx="38" cy="38" r="9" fill="var(--color-bg)" stroke="currentColor" stroke-width="3.5"/>
  <circle cx="38" cy="38" r="3.2" fill="currentColor"/>
</svg>`;
---

<footer class="border-t border-border py-12 mt-24">
  <div class="container-wide grid gap-8 sm:grid-cols-2 md:grid-cols-4 text-sm">
    <div>
      <p class="flex items-center gap-2 text-fg lowercase font-semibold"><span set:html={chisel} />tracelane</p>
      <p class="mt-3 text-fg-subtle text-xs leading-relaxed">The flight recorder for AI agents. Apache 2.0.</p>
    </div>
    <nav aria-label="Product">
      <p class="font-mono text-xs text-fg-dim mb-3 lowercase tracking-wider">product</p>
      <ul class="space-y-2 text-fg-muted lowercase">
        <li><a href="/#what" class="hover:text-fg transition-colors">what</a></li>
        <li><a href="/#audit" class="hover:text-fg transition-colors">audit ledger</a></li>
        <li><a href="/#pricing" class="hover:text-fg transition-colors">pricing</a></li>
        <li><a href="https://docs.tracelane.dev" class="hover:text-fg transition-colors" rel="noopener">docs</a></li>
      </ul>
    </nav>
    <nav aria-label="Resources">
      <p class="font-mono text-xs text-fg-dim mb-3 lowercase tracking-wider">resources</p>
      <ul class="space-y-2 text-fg-muted lowercase">
        <li><a href="https://github.com/tracelane" class="hover:text-fg transition-colors" rel="me noopener">github</a></li>
        <li><a href="/security" class="hover:text-fg transition-colors">security</a></li>
        <li><a href="https://newsletter.aitechhive.com" class="hover:text-fg transition-colors" rel="noopener">working notes</a></li>
        <li><a href="/changelog" class="hover:text-fg transition-colors">changelog</a></li>
      </ul>
    </nav>
    <nav aria-label="Legal">
      <p class="font-mono text-xs text-fg-dim mb-3 lowercase tracking-wider">legal</p>
      <ul class="space-y-2 text-fg-muted lowercase">
        <li><a href="/privacy" class="hover:text-fg transition-colors">privacy</a></li>
        <li><a href="/terms" class="hover:text-fg transition-colors">terms</a></li>
        <li class="text-fg-subtle text-xs pt-2">support@tracelane.dev</li>
      </ul>
    </nav>
  </div>
  <div class="container-wide mt-12 pt-6 border-t border-border text-xs text-fg-subtle font-mono flex flex-col sm:flex-row gap-2 justify-between lowercase">
    <p>© 2026 tracelane. Apache 2.0 core · CC-BY-4.0 site content.</p>
    <p>payments via Polar.sh at launch.</p>
  </div>
</footer>
