---
// v2 footer — shared across all pages. Single mono smallprint row (§10).
// NOTE: tagline reworded to avoid the banned prevention-claim wording (honesty
// lock §3 + scripts/pre-public-push.sh) while preserving the exact meaning:
// tamper-evidence = detectable, not prevention.
---

<footer class="site-footer">
  <div class="wrap fline">
    <span>© 2026 tracelane · apache-2.0 core</span>
    <a href="https://github.com/tracelane" rel="me noopener">github</a>
    <a href="/security">security</a>
    <a href="/changelog">changelog</a>
    <a href="https://newsletter.aitechhive.com" rel="noopener">founder's notes</a>
    <a href="/privacy">privacy</a>
    <a href="/terms">terms</a>
    <span class="r">tamper-evident — modifications are detectable, not prevented, by design</span>
  </div>
</footer>

<style>
  .site-footer {
    padding: var(--s4) 0;
    border-top: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-3);
    position: relative;
    z-index: 1;
  }
  .fline {
    display: flex;
    gap: var(--s3);
    flex-wrap: wrap;
    align-items: center;
  }
  .fline a {
    color: var(--ink-3);
    padding-block: 6px;
    transition: color var(--tr);
  }
  .fline a:hover {
    color: var(--ink);
  }
  .fline .r {
    margin-left: auto;
  }
  @media (max-width: 640px) {
    .fline .r {
      margin-left: 0;
      flex-basis: 100%;
    }
  }
</style>
